{
	"name": "@xynogen/pix-fetch",
	"version": "0.1.0",
	"description": "Provider-neutral URL fetch tool with plain-text output for Pi",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./providers": "./src/providers.ts",
		"./runner": "./src/runner.ts"
	},
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"!src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"fetch"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-fetch"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-fetch#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	},
	"dependencies": {
		"@xynogen/pix-pretty": "^1.26.0",
		"@xynogen/pix-runtime": "^0.10.1",
		"typebox": "^1.1.38"
	}
}
