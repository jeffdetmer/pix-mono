{
	"name": "@xynogen/pix-runner",
	"version": "0.1.0",
	"description": "Pi tool — run and manage long-lived processes (npm run dev, vite, python) that outlive a turn",
	"type": "module",
	"main": "src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "bun test"
	},
	"files": [
		"src",
		"!src/**/*.test.*",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	},
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"process",
		"runner",
		"background"
	],
	"author": "xynogen",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xynogen/pix-mono.git",
		"directory": "packages/pix-runner"
	},
	"homepage": "https://github.com/xynogen/pix-mono/tree/main/packages/pix-runner#readme",
	"bugs": {
		"url": "https://github.com/xynogen/pix-mono/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@xynogen/pix-pretty": "^1.26.0",
		"@xynogen/pix-runtime": "^0.10.1",
		"typebox": "^1.1.38"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
}
